# NetChimera configuration.
# Copy to .env and edit. Every value shown is the default; with no .env at all
# the stack runs fully offline using the deterministic mock AI generator.

# --- Proxy and API ---------------------------------------------------------
PROXY_ADDR=127.0.0.1:8080
API_ADDR=127.0.0.1:8081
UPSTREAM_URL=http://127.0.0.1:9090
FORWARD_ALLOWED_HOSTS=localhost,127.0.0.1,target-lab
UI_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Pipeline ----------------------------------------------------------------
# INSPECT_WORKERS defaults to the number of CPUs when unset.
# INSPECT_WORKERS=8
INSPECT_QUEUE_SIZE=4096
ANOMALY_THRESHOLD=0.65
REDACT_TELEMETRY=true

# --- AI agent ----------------------------------------------------------------
# AI_MODE=auto uses the live provider when AI_API_KEY and AI_MODEL are both set,
# otherwise the mock generator. AI_MODE=mock forces the mock generator.
AI_MODE=auto
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=45s
AI_WORKERS=2
AI_QUEUE_SIZE=64
AI_DEDUPE_TTL=120s

# Provider presets (uncomment one block):
#
# OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=<your OpenAI key>
# AI_MODEL=<a chat model enabled on your account>
#
# Ollama (local; Ollama ignores the key but it must be non-empty)
# AI_BASE_URL=http://localhost:11434/v1
# From inside Docker use: http://host.docker.internal:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=<a model you have pulled, e.g. from `ollama list`>
#
# DeepSeek
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=<your DeepSeek key>
# AI_MODEL=deepseek-chat

# --- Target lab --------------------------------------------------------------
TARGET_ADDR=127.0.0.1:9090

# --- UI (read by the browser, so localhost is correct even under Docker) -----
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws
NEXT_PUBLIC_API_URL=http://localhost:8081
